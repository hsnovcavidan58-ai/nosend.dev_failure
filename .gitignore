ehthumbs_vista.db
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# --- Linux desktop metadata ---
.directory
.Trash-*
.nfs*


# =============================================================================
