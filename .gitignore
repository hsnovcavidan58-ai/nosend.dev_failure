# =============================================================================
# nosend.dev — Git Ignore Rules
# =============================================================================
#
# ⚠️  SECURITY-CRITICAL FILE — DO NOT EDIT WITHOUT SECURITY REVIEW
#
# This file is the last line of defense against accidental secret leaks.
# The entries in the "🔴 SECRETS" and "🔴 CLOUDFLARE WRANGLER" sections
# below MUST NEVER be removed, renamed, or commented out.
#
# If any of the following ever lands in Git history, treat the corresponding
# credential as COMPROMISED and rotate it immediately. See README.md →
# "🔒 Security Notes" for the incident-response procedure.
#
#   File pattern         Secret it typically contains
#   ─────────────────    ─────────────────────────────────────────────────────
#   .env / .env.*        General environment secrets
#   .dev.vars            LS_API_KEY (Lemon Squeezy)          ← CRITICAL
#   .dev.vars.*          Variants of the above
#   .wrangler/           Local Worker state, may cache secrets
#   *.pem / *.key        TLS / signing private keys
#
# Threat model:
#   Public GitHub repos are scanned by automated credential-harvesting bots
#   within ~5 minutes of every push. A leaked Lemon Squeezy API key allows
#   full account takeover and immediate revenue-model collapse.
#
# =============================================================================


# -----------------------------------------------------------------------------
# 🔴 SECRETS & ENVIRONMENT VARIABLES
# -----------------------------------------------------------------------------
# Never commit any file containing real credentials, API keys, or tokens.
# Only `.env.example` is intentionally tracked, as a documented template.

.env
.env.*
!.env.example

.dev.vars
.dev.vars.*

*.pem
*.key
*.p12
*.pfx

secrets.json
credentials.json
service-account.json


# -----------------------------------------------------------------------------
# 🔴 CLOUDFLARE WRANGLER (Workers & Pages local tooling)
# -----------------------------------------------------------------------------
# `.wrangler/` holds local Wrangler state: KV/D1/R2 emulation, build cache,
# and — most importantly — secrets loaded by `wrangler dev` from `.dev.vars`.
# It is regenerated on demand and MUST NOT be tracked.

.wrangler/
.wrangler.toml.bak
worker/.wrangler/
worker/.dev.vars
worker/.dev.vars.*

# Miniflare local storage (used by `wrangler dev` under the hood)
.mf/
.miniflare/


# -----------------------------------------------------------------------------
# DEPENDENCIES
# -----------------------------------------------------------------------------

node_modules/
jspm_packages/
web_modules/
bower_components/
pnpm-store/
.pnpm-store/

# Yarn PnP (zero-install) — keep required metadata, ignore the rest
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions


# -----------------------------------------------------------------------------
# BUILD OUTPUT & DISTRIBUTION
# -----------------------------------------------------------------------------
# NOTE: `public/` is intentionally NOT ignored — it is the Cloudflare Pages
# deploy root and MUST remain tracked in Git.

dist/
dist-ssr/
build/
build/Release/
out/
.output/

*.tsbuildinfo

# Framework / bundler output
.next/
.nuxt/
.svelte-kit/
.vite/
.astro/
.docusaurus/
.serverless/
.fusebox/
.parcel-cache/
.cache/
.turbo/
.firebase/
.dynamodb/
.vuepress/dist/
.vuepress/.temp/
**/.vitepress/dist
**/.vitepress/cache


# -----------------------------------------------------------------------------
# LOGS
# -----------------------------------------------------------------------------

logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json


# -----------------------------------------------------------------------------
# RUNTIME DATA
# -----------------------------------------------------------------------------

pids
*.pid
*.seed
*.pid.lock
.node_repl_history


# -----------------------------------------------------------------------------
# TESTING & COVERAGE
# -----------------------------------------------------------------------------

coverage/
*.lcov
.nyc_output/
lib-cov/


# -----------------------------------------------------------------------------
# TOOL CACHES
# -----------------------------------------------------------------------------

.npm/
.eslintcache
.stylelintcache
.grunt/
.lock-wscript
*.tgz
.yarn-integrity
.tern-port
.vscode-test
.node-gyp/


# -----------------------------------------------------------------------------
# TEMPORARY & BACKUP FILES
# -----------------------------------------------------------------------------

*.bak
*.orig
*.rej
*.tmp
*.temp
*.swp
*.swo
*~
.history/
.tmp/
.temp/


# -----------------------------------------------------------------------------
# OPERATING SYSTEM METADATA
# -----------------------------------------------------------------------------

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk


# -----------------------------------------------------------------------------
# EDITORS & IDEs
# -----------------------------------------------------------------------------

.vscode/
.idea/
*.iml
*.code-workspace
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
nbproject/

# AI coding assistants (local config only — do not track)
.claude/
.cursor/
.aider*
.continue/


# -----------------------------------------------------------------------------
# LOCAL DATABASES & DUMPS (Worker development only)
# -----------------------------------------------------------------------------

worker/.local/
worker/*.sqlite
worker/*.sqlite-journal
worker/*.db
worker/*.db-journal
worker/*.dump


# -----------------------------------------------------------------------------
# PROJECT-SPECIFIC — PERSONAL / DRAFT FILES
# -----------------------------------------------------------------------------
# Draft notes and experiments that must never be deployed or published.
# Uncomment individual lines if such files are created inside the repo root.

# docs/*-draft.md
# docs/*-scratch.md
# public/tools/*/test-*.html
# public/assets/img/og-image-draft.*
